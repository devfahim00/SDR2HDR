<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.SDR2HDR.Button.Back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Back"
            app:icon="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDR10 Grading"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="BT.2020 · SMPTE 2084 PQ"
                android:textColor="@color/text_dim"
                android:textSize="11.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.SDR2HDR.Button.Reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Selected video (file card) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDR2HDR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_file_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/image_thumb"
                            android:layout_width="84dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_thumb"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.SDR2HDR.Thumb" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_file"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:textColor="@color/text"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/text_file_meta"
                                style="@style/Text.MonoDim"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Presets: encoder speed + platform target + metadata -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDR2HDR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Encoder Speed" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/group_preset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/preset_ultrafast"
                            style="@style/Widget.SDR2HDR.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x26A1; Ultrafast" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/preset_fast"
                            style="@style/Widget.SDR2HDR.Pill.Default"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="&#x1F680; Fast" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/preset_medium"
                            style="@style/Widget.SDR2HDR.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x2696;&#xFE0F; Medium" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/preset_slow"
                            style="@style/Widget.SDR2HDR.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x1F48E; Slow" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/text_preset_hint"
                        style="@style/Text.MonoDim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Balanced speed and file size (default)"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/border" />

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Platform Target" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/group_platform"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/platform_none"
                            style="@style/Widget.SDR2HDR.Pill.Default"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="&#x2014; Original" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/platform_tiktok"
                            style="@style/Widget.SDR2HDR.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x266A; TikTok" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/platform_instagram"
                            style="@style/Widget.SDR2HDR.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x25CE; Instagram" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/text_platform_hint"
                        style="@style/Text.MonoDim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Keep original frame rate and bitrate"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Clean metadata"
                                android:textColor="@color/text"
                                android:textSize="13sp" />

                            <TextView
                                style="@style/Text.MonoDim"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Strip old / unwanted metadata"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_strip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage: source frame + HDR10 spec badges -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDR2HDR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/image_preview"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:background="#000000"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:layout_constraintDimensionRatio="H,16:9"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.SDR2HDR.Thumb" />

                        <TextView
                            style="@style/Text.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_pill_dark"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="&#x25CF; SDR SOURCE"
                            android:textColor="@color/white"
                            android:textSize="9.5sp"
                            app:layout_constraintStart_toStartOf="@id/image_preview"
                            app:layout_constraintTop_toTopOf="@id/image_preview" />

                        <TextView
                            style="@style/Text.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_pill_dark"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="SMPTE 2084 PQ"
                            android:textColor="@color/green_accent"
                            android:textSize="9.5sp"
                            app:layout_constraintEnd_toEndOf="@id/image_preview"
                            app:layout_constraintTop_toTopOf="@id/image_preview" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                style="@style/Text.Section"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Depth"
                                android:textSize="8.5sp" />

                            <TextView
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="10-Bit Main10"
                                android:textColor="@color/blue"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                style="@style/Text.Section"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Colorspace"
                                android:textSize="8.5sp" />

                            <TextView
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="BT.2020 WCG"
                                android:textColor="@color/blue"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                style="@style/Text.Section"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MaxCLL"
                                android:textSize="8.5sp" />

                            <TextView
                                android:id="@+id/badge_nits"
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="240 Nits"
                                android:textColor="@color/blue"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fine-tune accordion -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SDR2HDR.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/btn_fine_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Fine-Tune Grading Controls"
                            android:textColor="@color/text"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/icon_fine_chevron"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_down"
                            android:tint="@color/text_dim" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fine_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:visibility="gone">

                        <!-- Exposure -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="Exposure"
                                android:textColor="@color/text"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/val_exposure"
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.25"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sl_exposure"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:max="120"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:progressDrawable="@drawable/seek_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/seek_thumb" />

                        <!-- Highlight -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="Highlight (MaxCLL nits)"
                                android:textColor="@color/text"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/val_highlight"
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="240"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sl_highlight"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:max="90"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:progressDrawable="@drawable/seek_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/seek_thumb" />

                        <!-- Saturation -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="Saturation"
                                android:textColor="@color/text"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/val_saturation"
                                style="@style/Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.25"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sl_saturation"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:max="60"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:progressDrawable="@drawable/seek_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/seek_thumb" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom dock -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Widget.SDR2HDR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Convert to HDR10"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />
    </FrameLayout>
</LinearLayout>
