<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:text="Adjust Grading Settings"
            android:textColor="@color/cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="2"
            android:paddingBottom="16dp"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exposure  [-3.0 to 3.0]  (Default: 0.25)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/input_exposure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.25"
            android:inputType="numberSigned|numberDecimal"
            android:text="0.25"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Highlight / MaxCLL  [nits]  (Default: 240)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/input_highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="240"
            android:inputType="number"
            android:text="240"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Saturation  [0.0 to 3.0]  (Default: 1.25)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/input_saturation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1.25"
            android:inputType="numberDecimal"
            android:text="1.25"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Encoder Preset"
            android:textColor="@color/yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/preset_ultrafast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ultrafast - fastest render" />

            <RadioButton
                android:id="@+id/preset_fast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="fast - default balanced" />

            <RadioButton
                android:id="@+id/preset_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="medium - better compression" />

            <RadioButton
                android:id="@+id/preset_slow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="slow - highest quality" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Platform Optimization"
            android:textColor="@color/yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_platform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/platform_none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="No - keep original fps &amp; rate" />

            <RadioButton
                android:id="@+id/platform_tiktok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TikTok - 60fps CFR, 16M cap, AAC 48k" />

            <RadioButton
                android:id="@+id/platform_instagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instagram - 30fps CFR, 14M cap, AAC 48k" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Metadata Cleaning"
            android:textColor="@color/yellow"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Strip old/unwanted metadata"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/cyan"
            android:text="Start Conversion"
            android:textColor="@color/bg_dark"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
