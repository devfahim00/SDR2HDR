<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/text_compare_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Before / After"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_left"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="SDR SOURCE"
                android:textSize="9.5sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_left"
                android:layout_width="match_parent"
                android:layout_height="185dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SDR2HDR.Thumb" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_right"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="HDR OUTPUT"
                android:textColor="@color/green"
                android:textSize="9.5sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_right"
                android:layout_width="match_parent"
                android:layout_height="185dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SDR2HDR.Thumb" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/text_compare_hint"
        style="@style/Text.MonoDim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="HDR side tonemapped for this screen"
        android:textSize="10sp" />
</LinearLayout>
